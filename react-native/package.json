{
  "name": "react-native-ffmpeg-kit",
  "version": "6.0.2",
  "description": "FFmpeg Kit for React Native (New Architecture / TurboModule fork)",
  "main": "src/index",
  "types": "src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "android",
    "ios",
    "ffmpeg-kit-react-native.podspec",
    "README.md",
    "!android/build",
    "!android/.gradle",
    "!**/__tests__",
    "!**/.DS_Store"
  ],
  "codegenConfig": {
    "name": "RNFFmpegKitSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.arthenica.ffmpegkit.reactnative"
    }
  },
  "scripts": {
    "test": "jest",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "android",
    "ffmpeg",
    "ffmpeg-kit",
    "ios"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/2004durgesh/ffmpeg-kit.git",
    "directory": "react-native"
  },
  "author": "Durgesh Kumar Dwivedi",
  "contributors": [
    "ARTHENICA <open-source@arthenica.com> (https://www.arthenica.com)"
  ],
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/2004durgesh/ffmpeg-kit/issues"
  },
  "homepage": "https://github.com/2004durgesh/ffmpeg-kit/tree/main/react-native",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.7.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@release-it/conventional-changelog": "^7.0.0",
    "@types/jest": "^29.5.4",
    "@types/react": "^19.2.0",
    "commitlint": "^17.7.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.6.4",
    "pod-install": "^0.1.39",
    "prettier": "^3.0.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "release-it": "^16.1.5",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.80.0"
  },
  "jest": {
    "preset": "react-native"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
