{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "ffmpegkit"
  ],
  "ios": {
    "iosModuleName": "NitroFFmpegKit"
  },
  "android": {
    "androidNamespace": [
      "ffmpegkit"
    ],
    "androidCxxLibName": "NitroFFmpegKit"
  },
  "autolinking": {
    "FFmpegKitCore": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridFFmpegKitCore"
      }
    },
    "FFmpegKitStorage": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridFFmpegKitStorage"
      }
    },
    "FFmpegKitPlatform": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridFFmpegKitPlatform"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridFFmpegKitPlatform"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "lib",
    "example",
    "ffmpeg"
  ]
}
