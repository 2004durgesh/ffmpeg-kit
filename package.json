{
  "name": "react-native-ffmpeg-kit",
  "version": "7.0.0-beta.6",
  "description": "FFmpeg Kit for React Native (Nitro Modules)",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-ffmpeg-kit-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "react-native-ffmpeg-kit.podspec",
    "README.md",
    "!ios/FFmpegKitFrameworks",
    "!ios/build",
    "!android/build",
    "!android/.cxx",
    "!android/.gradle",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-ffmpeg-kit-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "nitrogen": "nitrogen",
    "prepare": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "android",
    "ffmpeg",
    "ffmpeg-kit",
    "ios"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2004durgesh/react-native-ffmpeg-kit.git"
  },
  "author": "Durgesh Kumar Dwivedi",
  "contributors": [
    "ARTHENICA <open-source@arthenica.com> (https://www.arthenica.com)"
  ],
  "license": "LGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/2004durgesh/react-native-ffmpeg-kit/issues"
  },
  "homepage": "https://github.com/2004durgesh/react-native-ffmpeg-kit#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.7.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/jest": "^29.5.4",
    "@types/react": "^19.2.0",
    "commitlint": "^17.7.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.6.4",
    "nitrogen": "0.37.2",
    "prettier": "^3.0.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.44.1",
    "react-native-nitro-modules": "0.37.2",
    "release-it": "^21.1.2",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.80.0",
    "react-native-nitro-modules": "^0.37.2"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/ffmpeg/"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/src/__tests__/setup.ts"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "nitrogen/generated/",
    "ffmpeg/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
